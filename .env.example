# KORA-05 chat provider credentials (example only; do NOT commit actual keys).
# The scripts read environment variables; they do not automatically load this file.
# PowerShell example: $env:GOOGLE_API_KEY = "your-key"
# Shared model factory and optional RAG default to local Ollama.
# SQL baseline now defaults to hosted NVIDIA Nemotron 3 Ultra.
# To use local SQL instead, pass --provider ollama explicitly.
GOOGLE_API_KEY=
# Alternative for Gemini when GOOGLE_API_KEY is not set:
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# NVIDIA NIM; SQL default model: nvidia/nemotron-3-ultra-550b-a55b.
# Set this variable in your shell; never commit or log an actual token.
NVIDIA_API_KEY=

# OpenAI's standard paid API uses a separate API key and billing account.
# Required only with --provider openai; do not put the real key in this file.
OPENAI_API_KEY=
# ChatGPT SIWC uses local OAuth credentials (not OPENAI_API_KEY).
# Sign in: uv run python -m scr.baselines.siwc_auth
# Models:  uv run python -m scr.baselines.chatgpt_siwc
